{
  "schemaVersion": 1,
  "id": "${mod_id}",
  "version": "${mod_version}",
  "name": "${mod_name}",
  "description": "Villagers ride along on camels and llamas: a camel ridden by a player or a carpeted llama on a player's lead picks up a villager it touches, and sneak + right-click lets the villager off again. Only needed on the server.",
  "authors": [
    "emberbocor"
  ],
  "contact": {
    "homepage": "https://github.com/emberbocor/villagerriders",
    "sources": "https://github.com/emberbocor/villagerriders",
    "issues": "https://github.com/emberbocor/villagerriders/issues"
  },
  "license": "${mod_license}",
  "environment": "*",
  "mixins": [
    "${mod_id}.mixins.json"
  ],
  "depends": {
    "fabricloader": "${fabric_loader_version_range}",
    "minecraft": "${fabric_minecraft_version_range}",
    "java": ">=21"
  }
}
